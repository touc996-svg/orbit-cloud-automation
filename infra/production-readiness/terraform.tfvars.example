project_name = "orbit"
aws_region   = "us-east-1"

alert_email = "replace-with-your-alert-email@example.com"

monthly_budget_usd         = 25
billing_alarm_threshold_pct = 80

github_repository = "touc996-svg/orbit-cloud-automation"

github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

state_bucket_name = "replace-with-your-existing-orbit-state-bucket"
lock_table_arn    = "arn:aws:dynamodb:us-east-1:123456789012:table/orbit-terraform-locks"

github_environments = [
  "development",
  "staging",
  "production"
]

daily_backup_retention_days  = 35
weekly_backup_retention_days = 90

# Optional. Supply a customer-managed KMS key ARN.
backup_kms_key_arn = ""
